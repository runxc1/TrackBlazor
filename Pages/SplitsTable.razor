@page "/splits-table"
@using TrackBlazor.Framework
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IToastService ToastService

<PageTitle>Splits Table</PageTitle>

<FluentCard Class="take-split" MinimalStyle="true" style="padding:8px;">
    <div style="margin-bottom:15px;">
        <h4>Splits Calculator</h4>
        
        @if (savedPresets.Any())
        {
            <FluentSelect TOption="string" 
                          @bind-Value="selectedPresetName" 
                          @bind-Value:after="OnPresetChanged"
                          Style="width:150px;">
                <FluentOption TOption="string" Value="">-- Select preset --</FluentOption>
                @foreach (var preset in savedPresets)
                {
                    <FluentOption TOption="string" Value="@preset.Name">@preset.Name</FluentOption>
                }
            </FluentSelect>
        }
    </div>

    <FluentStack Orientation="Orientation.Vertical" Style="gap:15px;">
        <!-- Admin Section (Collapsible) -->
        <FluentAccordion>
            <FluentAccordionItem Heading="Admin Settings" Expanded="@isAdminExpanded">
                <FluentStack Orientation="Orientation.Vertical" Style="gap:15px; padding:10px;">
                    <!-- Distance Input Section -->
                    <div>
                        <FluentNumberField @bind-Value="distance" @bind-Value:after="CalculateSplits" Min="1" Style="width:100%; margin-top:5px;" Label="Distance (meters)"></FluentNumberField>
                    </div>

                    <!-- Time Names Section -->
                    <div>
                        <FluentLabel>Pace and Name (optional)</FluentLabel>
                        @foreach (var entry in timeEntries)
                        {
                            <div class="flexCont" style="gap:5px; margin-top:5px; align-items:end;">
                                <FluentTextField @bind-Value="entry.Name" @bind-Value:after="CalculateSplits" Placeholder="Runner Name" Style="flex:1;"></FluentTextField>
                                <FluentNumberField @bind-Value="entry.TotalMinutes" @bind-Value:after="CalculateSplits" Min="0" Max="59" Label="Min" Style="width:70px;"></FluentNumberField>
                                <FluentNumberField @bind-Value="entry.TotalSeconds" @bind-Value:after="CalculateSplits" Min="0" Max="59" Label="Sec" Style="width:70px;"></FluentNumberField>
                                <FluentButton Appearance="Appearance.Outline" @onclick="() => RemoveTimeEntry(entry)" IconEnd="new Icons.Regular.Size20.Delete()"></FluentButton>
                            </div>
                        }
                        <FluentButton Appearance="Appearance.Accent" @onclick="AddTimeEntry" IconStart="new Icons.Regular.Size20.Add()" Style="margin-top:5px;">Add Time</FluentButton>
                    </div>

                    <!-- Split Distances Section -->
                    <div>
                        <FluentLabel>Split Distances (meters)</FluentLabel>
                        <div class="flexCont" style="gap:5px; flex-wrap:wrap; margin-top:5px;">
                            @foreach (var splitDist in splitDistances)
                            {
                                <div style="display:inline-flex; align-items:center; padding:5px 10px; background-color:var(--accent-fill-rest); color:white; border-radius:4px;">
                                    <span>@splitDist</span>
                                    <FluentButton Appearance="Appearance.Lightweight" @onclick="() => RemoveSplitDistance(splitDist)" IconEnd="new Icons.Regular.Size20.Dismiss()" Style="color:white; margin-left:5px; padding:0 5px; min-width:20px;"></FluentButton>
                                </div>
                            }
                        </div>
                        <div class="flexCont" style="gap:5px; margin-top:5px;">
                            <FluentNumberField @bind-Value="newSplitDistance" Min="1" Placeholder="Enter distance" Style="flex:0 1 100px;"></FluentNumberField>
                            <FluentButton Appearance="Appearance.Accent" @onclick="AddSplitDistance">Add Split</FluentButton>
                        </div>
                    </div>

                    <!-- Save Preset Section -->
                    <div style="border-top:1px solid #ccc; padding-top:15px;">
                        <FluentLabel>Save Preset</FluentLabel>
                        <div class="flexCont" style="gap:5px; margin-top:5px;">
                            <FluentTextField @bind-Value="presetName" Placeholder="Preset name" Style="flex:1;"></FluentTextField>
                            <FluentButton Appearance="Appearance.Accent" @onclick="SavePreset" IconStart="new Icons.Regular.Size20.Save()">Save</FluentButton>
                            @if (!string.IsNullOrEmpty(selectedPresetName))
                            {
                                <FluentButton Appearance="Appearance.Outline" @onclick="DeletePreset" IconEnd="new Icons.Regular.Size20.Delete()">Delete</FluentButton>
                            }
                        </div>
                    </div>
                </FluentStack>
            </FluentAccordionItem>
        </FluentAccordion>

        <!-- Results Table -->
        @if (calculations.Any())
        {
            <div style="overflow-x:auto;">
                <table class="splits-table">
                    <thead>
                        <tr>
                            <th>Split Name</th>
                            @foreach (var splitDist in splitDistances.OrderBy(d => d))
                            {
                                <th>@splitDist</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var calc in calculations)
                        {
                            <tr>
                                <td>@calc.RunnerName</td>
                                @foreach (var splitDist in splitDistances.OrderBy(d => d))
                                {
                                    <td>@calc.GetFormattedTime(splitDist)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </FluentStack>
</FluentCard>

<style>
    .splits-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .splits-table th,
    .splits-table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
    }

    .splits-table th {
        background-color: var(--accent-fill-rest);
        color: white;
        font-weight: bold;
    }

    .splits-table tr:nth-child(even) {
            background-color: var(--neutral-stroke-layer-active);
    }
</style>

@code {
    private int distance = 1600;
    private List<TimeEntry> timeEntries = new List<TimeEntry>();
    private List<int> splitDistances = new List<int> { 200, 400, 800 };
    private int newSplitDistance = 200;
    private List<SplitCalculation> calculations = new List<SplitCalculation>();
    private string presetName = "Default";
    private string selectedPresetName = "";
    private List<SplitsTablePreset> savedPresets = new List<SplitsTablePreset>();
    private bool isAdminExpanded = true;

    protected override async Task OnInitializedAsync()
    {
        var presets = await localStorage.GetItemAsync<List<SplitsTablePreset>>("SplitsTablePresets");
        if (presets != null)
        {
            savedPresets = presets;
        }

        // Initialize default time entries
        timeEntries = new List<TimeEntry>
        {
            new TimeEntry { Name = "", TotalMinutes = 4, TotalSeconds = 30 },
            new TimeEntry { Name = "", TotalMinutes = 5, TotalSeconds = 0 },
            new TimeEntry { Name = "", TotalMinutes = 5, TotalSeconds = 30 },
            new TimeEntry { Name = "", TotalMinutes = 6, TotalSeconds = 0 }
        };

        CalculateSplits();
    }

    private void SetDistance(int dist)
    {
        distance = dist;
        CalculateSplits();
    }

    private void AddTimeEntry()
    {
        timeEntries.Add(new TimeEntry { Name = "", TotalMinutes = 5, TotalSeconds = 0 });
        CalculateSplits();
    }

    private void RemoveTimeEntry(TimeEntry entry)
    {
        timeEntries.Remove(entry);
        CalculateSplits();
    }

    private void AddSplitDistance()
    {
        if (newSplitDistance > 0 && !splitDistances.Contains(newSplitDistance))
        {
            splitDistances.Add(newSplitDistance);
            splitDistances = splitDistances.OrderBy(d => d).ToList();
            CalculateSplits();
        }
    }

    private void RemoveSplitDistance(int distance)
    {
        splitDistances.Remove(distance);
        CalculateSplits();
    }

    private void CalculateSplits()
    {
        calculations.Clear();
        foreach (var entry in timeEntries)
        {
            var calc = SplitCalculation.Calculate(entry, distance, splitDistances);
            calculations.Add(calc);
        }
    }

    private void OnPresetChanged()
    {
        if (!string.IsNullOrEmpty(selectedPresetName))
        {
            LoadPreset();
        }
    }

    private async Task SavePreset()
    {
        if (string.IsNullOrWhiteSpace(presetName))
        {
            ToastService.ShowWarning("Please enter a preset name");
            return;
        }

        var preset = new SplitsTablePreset
        {
            Name = presetName,
            Distance = distance,
            TimeEntries = new List<TimeEntry>(timeEntries.Select(e => new TimeEntry 
            { 
                Name = e.Name, 
                TotalMinutes = e.TotalMinutes, 
                TotalSeconds = e.TotalSeconds 
            })),
            SplitDistances = new List<int>(splitDistances)
        };

        var existingIndex = savedPresets.FindIndex(p => p.Name == presetName);
        if (existingIndex >= 0)
        {
            savedPresets[existingIndex] = preset;
        }
        else
        {
            savedPresets.Add(preset);
        }

        await localStorage.SetItemAsync("SplitsTablePresets", savedPresets);
        ToastService.ShowSuccess($"Preset '{presetName}' saved");
        selectedPresetName = presetName;
    }

    private void LoadPreset()
    {
        isAdminExpanded = false;
        var preset = savedPresets.FirstOrDefault(p => p.Name == selectedPresetName);
        if (preset != null)
        {
            distance = preset.Distance;
            timeEntries = preset.TimeEntries.Select(e => new TimeEntry 
            { 
                Name = e.Name, 
                TotalMinutes = e.TotalMinutes, 
                TotalSeconds = e.TotalSeconds 
            }).ToList();
            splitDistances = new List<int>(preset.SplitDistances);
            presetName = preset.Name;
            CalculateSplits();
        }
    }

    private async Task DeletePreset()
    {
        var preset = savedPresets.FirstOrDefault(p => p.Name == selectedPresetName);
        if (preset != null)
        {
            savedPresets.Remove(preset);
            await localStorage.SetItemAsync("SplitsTablePresets", savedPresets);
            ToastService.ShowSuccess($"Preset '{selectedPresetName}' deleted");
            selectedPresetName = "";
            presetName = "Default";
        }
    }
}
